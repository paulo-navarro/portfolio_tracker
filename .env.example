# ── Banco ─────────────────────────────────────────────
# O DATABASE_URL não mora aqui: o compose monta uma URL por role, com o host
# certo de cada perfil (db em dev, db-prod em prod).
# Senhas vão dentro de uma URL: use só letras e números.
#
# POSTGRES_* é o dono do banco. Só o serviço `migrate` usa. O Postgres grava
# a senha no primeiro boot do volume: trocar aqui depois não muda a do banco.
# Em prod, as três senhas: openssl rand -hex 24 (o migrate recusa menos de 32).
POSTGRES_USER=cripto
POSTGRES_PASSWORD=cripto
POSTGRES_DB=cripto

# Roles de runtime. O migrate aplica estas senhas a cada boot, então trocar aqui
# e subir de novo basta.
#   app_api    — a API. Nunca lê as credenciais das corretoras.
#   app_worker — o worker. O único que lê.
APP_API_PASSWORD=criptoapidev
APP_WORKER_PASSWORD=criptoworkerdev

# ── Login ─────────────────────────────────────────────
# OAuth client do Google (tipo "Web application"). Redirect URIs cadastradas:
#   http://localhost:5175/api/auth/google/callback      (dev)
#   https://<CLIENT_ORIGIN>/api/auth/google/callback      (prod)
# Em dev dá para ficar sem: DEV_LOGIN entra como o usuário de dev.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Quem pode entrar, separado por vírgula. Vazio em prod: ninguém entra, e a api
# se recusa a subir.
ALLOWED_EMAILS=
# Só dev: botão "entrar como dev" sem Google. Em prod é sempre false.
# DEV_LOGIN=true
# Prod: o endereço do app, como o navegador escreve (https://…, sem / no fim).
CLIENT_ORIGIN=
# IP de saída do worker (o da VPS), para a tela sugerir vincular a chave a ele.
EGRESS_IP=

# ── Coleta ────────────────────────────────────────────
# Minutos entre coletas. O banco guarda um retrato por dia de qualquer jeito.
# COLLECT_INTERVAL_MIN=15
# Valem 1 dólar e não são cotadas. Vazio usa a lista padrão
# (USDT, USDC, FDUSD, BUSD, TUSD, USDP, DAI, USDE, PYUSD, USD1).
# STABLECOINS=

# ── Portas ────────────────────────────────────────────
CRIPTO_DEV_PORT=5175
CRIPTO_PORT=8084
# 127.0.0.1 numa VPS; 0.0.0.0 para testar a imagem de prod pela LAN.
CRIPTO_BIND=127.0.0.1
