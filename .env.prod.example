# Produção: este arquivo vive só na VPS, em /root/cripto/.env, fora do git.
# Troque TODOS os segredos. O migrate recusa subir com senha fraca, e a api
# recusa subir sem Google, sem lista de e-mails ou com o login de dev ligado.

# ── Banco ─────────────────────────────────────────────
# Três senhas diferentes: openssl rand -hex 24 (só letras e números; elas vão
# dentro de uma URL). A do dono é gravada no primeiro boot do volume.
POSTGRES_USER=cripto
POSTGRES_PASSWORD=
POSTGRES_DB=cripto
APP_API_PASSWORD=
APP_WORKER_PASSWORD=

# ── Login ─────────────────────────────────────────────
# OAuth client do Google (tipo "Web application"), com este endereço de retorno:
#   https://cripto.paulonavarro.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Quem pode entrar, separado por vírgula. Vazio: a api não sobe.
ALLOWED_EMAILS=
# O endereço do app, sem barra no fim. O Origin de toda escrita tem que bater.
CLIENT_ORIGIN=https://cripto.paulonavarro.com
# Nunca true aqui: o assertApiConfig recusa.
DEV_LOGIN_PROD=false
SECURE_COOKIES=true
# nginx de borda + nginx do container = 2 saltos confiáveis.
TRUST_PROXY_HOPS=2
# IP de saída do worker: a tela sugere vincular a chave da corretora a ele.
EGRESS_IP=76.13.172.71

# ── Coleta ────────────────────────────────────────────
# COLLECT_INTERVAL_MIN=15
# STABLECOINS=
# HIDE_BELOW_USD=0.10

# ── Portas ────────────────────────────────────────────
# Só loopback: o nginx de borda é a única entrada.
CRIPTO_BIND=127.0.0.1
CRIPTO_PORT=8084
